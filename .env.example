# ============================================
# PRODUCTION DEPLOYMENT NOTES (Render + Neon + Upstash)
# ============================================
#
# Required changes for production:
#   NODE_ENV=production
#   PORT=10000              (Render injects this — do NOT override)
#   LOG_LEVEL=info          (not debug)
#   DATABASE_URL            → Neon connection string (sslmode=require)
#   REDIS_URL               → Upstash connection string (rediss://)
#   CLIENT_URL              → your frontend production URL
#   SERVER_URL              → https://writespace-api.onrender.com
#   CORS_ORIGINS            → https://your-frontend.com
#
# ============================================

PORT=8000
NODE_ENV=development  # development, production, test

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/writespace
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# --------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=redis_password
DB_CONNECTION_TIMEOUT_MS=10000

# BullMQ / Workers
EMAIL_WORKER_CONCURRENCY=5
INTERACTION_WORKER_CONCURRENCY=10
MEDIA_WORKER_CONCURRENCY=5
EMAIL_QUEUE_ATTEMPTS=3
INTERACTION_QUEUE_ATTEMPTS=2
MEDIA_QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_DELAY_MS=1000

# HTTP / Application
# https://writespace-api.onrender.com
SERVER_URL=http://localhost:8000/api/v1
CLIENT_URL=http://localhost:5173
SHUTDOWN_TIMEOUT_MS=10000

# Authentication
JWT_ACCESS_SECRET=jwt_access_token
JWT_REFRESH_SECRET=jwt_refresh_token
JWT_ACCESS_EXPIRE=15m           # 15 minutes (use: 15m, 1h, 7d)
JWT_REFRESH_EXPIRE=7d           # 7 days

# Cloudinary
CLOUDINARY_CLOUD_NAME=cloudinary_name
CLOUDINARY_API_KEY=cloudinary_api_key
CLOUDINARY_API_SECRET=cloudinary_api_secret

# Upload limits
MAX_FILE_SIZE_MB=5               # Maximum file size in MB
MAX_FILES_PER_UPLOAD=12          # Maximum number of files per upload

# SMTP

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=smtp_user@gmail.com
SMTP_PASS=smtp_app_password
SMTP_SECURE=false  # true for port 465, false for 587

# Email Sender Details
EMAIL_FROM=noreply@writespace.com
EMAIL_FROM_NAME=WriteSpace

# Google OAuth
GOOGLE_CLIENT_ID=google_oauth_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID= github_client_id
GITHUB_CLIENT_SECRET=github_client_secret
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

RATE_LIMIT_WINDOW_MS=900000      # 15 minutes (in milliseconds)
RATE_LIMIT_MAX_REQUESTS=100      # Maximum requests per window

LOG_LEVEL=debug                  # debug, info, warn, error

# CORS Configuration
# --------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5173

SESSION_SECRET=session_secret

# Authentication
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5   # Only 5 login attempts per 15 minutes

PASSWORD_RESET_TOKEN_EXPIRY=3600000  # 1 hour in milliseconds
PASSWORD_RESET_CODE_LENGTH=6         # Length of numeric reset code

# Feature Flags (Enable/disable features)
# --------------------------------------------
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_POST_SCHEDULING=true
ENABLE_USER_SHARE=true

# Development Only
# --------------------------------------------
# Automatically run migrations on startup (development only)
AUTO_MIGRATE=false

# Seed database with test data on startup (development only)
SEED_DATABASE=false

# AI Configuration

# Global AI kill switch
AI_ENABLED=true

# Available providers: gemini, mock
AI_PROVIDER=gemini

# Gemini API key
GEMINI_API_KEY=gemeni_api_key

# Gemini model
AI_MODEL=paste_the_ai_model_you_gonna_implement

# AI request timeout
AI_TIMEOUT_MS=60000

# Maximum input size sent to AI
AI_MAX_INPUT_CHARS=12000

# Maximum generated output tokens
AI_MAX_OUTPUT_TOKENS=1000

# Number of retries for transient AI failures
AI_MAX_RETRIES=2

# --- Embedding Configuration ---
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-large:335m-en-v1.5-fp16
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=16

# Performance Monitoring
# --------------------------------------------
# New Relic APM (optional)
# NEW_RELIC_LICENSE_KEY=your-key
# NEW_RELIC_APP_NAME=writespace-api

# Sentry Error Tracking (optional)
# SENTRY_DSN=https://your-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=development

# ============================================
# Important Notes:
# 1. Never commit .env files to version control
# 2. Keep secrets secure and rotate periodically
# 3. Use different values for each environment
# 4. Generate strong secrets using: openssl rand -base64 32
# ============================================